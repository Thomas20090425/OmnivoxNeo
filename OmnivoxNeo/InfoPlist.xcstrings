    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omnivox Neo adds your coursework deadlines and campus events to a calendar of its own, and keeps it up to date as your portal changes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omnivox Neo ajoute vos échéances de travaux et les événements du campus à son propre calendrier, et le tient à jour au fil des changements de votre portail."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to unlock your securely saved OmniVox password and protect your school information."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Face ID pour déverrouiller votre mot de passe OmniVox enregistré et protéger vos informations scolaires."
